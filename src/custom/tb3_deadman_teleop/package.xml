<?xml version="1.0"?>
<package format="3">
  <name>tb3_deadman_teleop</name>
  <version>1.0.0</version>
  <description>
    Minimal host-safe TurtleBot3 Burger fake-node and dead-man keyboard teleoperation.
  </description>

  <maintainer email="maintainer@example.invalid">TurtleBot3 Lab</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>turtlebot3_description</exec_depend>
  <exec_depend>turtlebot3_fake_node</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
